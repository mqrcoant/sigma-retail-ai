    "plantilla": "ingreso_mes",
    "parametros": {},
    "sql": "SELECT t.anio_mes etiqueta, ROUND(SUM(f.ingreso_neto_cent)/100.0,2) valor FROM fact_ventas f JOIN dim_tiempo t ON t.tiempo_sk=f.tiempo_sk JOIN dim_producto p ON p.producto_sk=f.producto_sk JOIN dim_cliente cl ON cl.cliente_sk=f.cliente_sk JOIN dim_sucursal s ON s.sucursal_sk=f.sucursal_sk JOIN dim_canal ca ON ca.canal_sk=f.canal_sk GROUP BY t.anio_mes ORDER BY t.anio_mes"
